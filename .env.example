# ==============================================================================
# Agentic AI eBook RAG Chatbot - Environment Configuration
# ==============================================================================

# Active LLM Provider: 'gemini' (Free testing tier) or 'openai'
LLM_PROVIDER=gemini

# Google Gemini API Credentials (required if LLM_PROVIDER=gemini)
# Get a key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Credentials (required if LLM_PROVIDER=openai)
# Get a key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Vector Database Credentials
# Get a key from: https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=agentic-ai-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Ingestion & Chunking Parameters
PDF_PATH=data/Ebook-Agentic-AI.pdf
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3

# Model Customizations (2026 Active Production Models)
GEMINI_MODEL=gemini-3.6-flash
# Gemini Embedding 2 (GA). Natively 3072 dims; system leverages Matryoshka truncation to 768 dims for Pinecone cost efficiency
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Set to true if you want provider-partitioned index names (e.g. agentic-ai-index-gemini)
# PINECONE_INDEX_PER_PROVIDER=false
